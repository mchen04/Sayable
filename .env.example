# Sayable environment template. Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys, secrets, or tokens.

# --- Public (safe to expose to the browser) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Billing --------------------------------------------------------------
# STRIPE_MODE=mock grants Premium WITHOUT taking payment — local/demo only.
# Production MUST set STRIPE_MODE=test with real test keys + webhook secret.
# Mock upgrades are refused when NODE_ENV=production unless SAYABLE_ALLOW_MOCK_BILLING=true.
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Store backend --------------------------------------------------------
# file = local JSON store (default for local smoke). Production uses supabase.
SAYABLE_STORE_BACKEND=file
SAYABLE_STORE_PATH=.sayable-data/store.json
# Required when SAYABLE_STORE_BACKEND=supabase (server-only, never NEXT_PUBLIC_):
SAYABLE_SUPABASE_SERVICE_ROLE_KEY=
# Required for the Supabase backend; encrypts guest share-link material at rest.
SAYABLE_TOKEN_ENCRYPTION_KEY=replace-with-random-32-byte-secret

# --- Operator / demo (server-only) ----------------------------------------
SAYABLE_ADMIN_TOKEN=replace-with-local-admin-token
# Required behind a proxy/load balancer in production so rate limits + the
# anonymous create-cap key on the real client IP instead of one shared bucket.
# SAYABLE_TRUST_PROXY_HEADERS=true
# Demo browser-claim auth. Keep false in production (use Supabase Google OAuth).
# Enable only for local smoke; when enabled in production a secret is required.
SAYABLE_DEMO_AUTH_ENABLED=false
SAYABLE_DEMO_AUTH_SECRET=replace-with-random-32-byte-secret

SUPPORT_EMAIL=support@sayable.app
